menu "MiniLingo Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "yourwifi"

    config WIFI_PASSWORD
        string "WiFi Password"
        default ""

    config GROQ_API_KEY
        string "Groq API Key"
        default ""

    config WHISPER_LANGUAGE
        string "Whisper language hint (ISO-639-1)"
        default "en"
        help
            Wird als language-Parameter an Groq Whisper geschickt
            (Spec Section 9.3) — ohne raet Whisper die Sprache, was
            Latenz kostet und die Genauigkeit verschlechtert.
            Default Englisch (Stand 2026-06-25): die lokalen Piper-
            Stimmen je Charakter sind Englisch-Modelle, nur eine
            (schwache) deutsche Stimme ist verfuegbar.

    config CEREBRAS_API_KEY
        string "Cerebras API Key"
        default ""
        help
            Fuer die Text-Antworten (LLM, ersetzt seit 2026-06-12
            Gemini — Free Tier 1 Mio. Token/Tag statt 250 Requests).
            Key von cloud.cerebras.ai.

    config LLM_MODEL
        string "Cerebras LLM model"
        default "gpt-oss-120b"
        help
            Modellname fuer api.cerebras.ai/v1/chat/completions.
            Verfuegbar im Free Tier (Stand 2026-06-12, per
            /v1/models geprueft): gpt-oss-120b, zai-glm-4.7.
            Achtung bei zai-glm-4.7: ignoriert reasoning_effort
            weitgehend -> laengere Antwortzeiten, Reasoning frisst
            vom max_completion_tokens-Budget.

    config GEMINI_API_KEY
        string "Gemini API Key (nur noch TTS, Phase 7)"
        default ""

    config GEMINI_VOICE_NAME
        string "Gemini TTS Voice"
        default "Kore"
        help
            Available: Kore, Puck, Charon, Fenrir, Aoede

    config TTS_SPEAK_REPLIES
        bool "Speak cloud replies via TTS"
        default y
        help
            Liest Antworten per TTS vor (primaer lokaler Piper-Server,
            Gemini nur als Fallback). Default an (Stand 2026-06-25):
            mit dem lokalen Piper-Server entfaellt das alte
            Gemini-Tageslimit und die 3-5 s Latenz, die das urspruengl-
            ich gegen "an" sprachen. Per Button weiterhin abschaltbar
            (CONFIG_TTS_SPEAK_REPLIES seedet nur den Startwert).

    config RECORDING_WAV_DUMP
        bool "Dump recordings as Base64 WAV over UART (Phase-3 test)"
        default n
        help
            Gibt nach jedem Audio-Capture den fertigen WAV-Buffer
            Base64-codiert ueber UART aus (Marker WAV_DUMP_BEGIN/END,
            ~30 s bei 115200 Baud). Mit tools/extract_wav.py aus dem
            gespeicherten Monitor-Log extrahieren. Achtung: schaltet
            waehrend des Dumps (~30 s) alle Logs stumm — seit Phase 4
            per Default aus.

    config WAKE_WORD_THRESHOLD
        int "WakeNet detection threshold (0-100, 0 = model default)"
        default 0
        help
            0 = Default des Models verwenden (steht im
            Model-Info-String des Boot-Logs).
            Sonst: hoeher = strenger (weniger False-Positives, aber
            das Wake Word muss deutlicher gesprochen werden). Wird
            auf 0.0-1.0 skaliert.

endmenu
