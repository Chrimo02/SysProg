# MiniLingo sdkconfig.defaults (Spec Section 14, angepasst fuer LVGL v9)
CONFIG_IDF_TARGET="esp32s3"

# PSRAM (ESP32-S3 N16R8: 8 MB Octal-PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Flash (16 MB) + Custom-Partitionstabelle (nvs, factory, model, storage)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU 240 MHz (esp-sr braucht volle Taktrate)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# mbedTLS aus dem PSRAM allokieren (Phase 5): der TLS-Handshake
# (~50 KB) passt neben esp-sr nicht mehr in den internen Heap
# (mbedtls_ssl_setup -0x7F00 = alloc failed).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# esp-sr (Phase 2): WakeNet9 "Mycroft" (bis 2026-06-11: Alexa).
# MultiNet7-EN wird schon jetzt in
# die model-Partition gepackt, damit fuer Phase 4 kein erneutes
# Model-Flashen noetig ist (geladen wird es erst dort).
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_MYCROFT_TTS=y
# CONFIG_SR_WN_WN9_ALEXA is not set
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# LVGL v9
# Hinweis: LV_COLOR_16_SWAP aus der Spec existiert in LVGL v9 nicht mehr;
# der Byte-Swap passiert stattdessen im Flush-Callback (drivers/display.c).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
